{
  "manifest_version": 3,
  "name": "Classroom Suite - Quick Downloader & Organizer",
  "version": "2.0.0",
  "description": "1-click batch download & smart ZIP organizer for Google Classroom. 100% client-side, zero servers, zero API keys.",
  "author": "Classroom Suite Open Source",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Classroom Suite Downloader",
    "default_icon": {
      "128": "icons/icon.svg"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*",
        "*://*/*test_classroom.html*"
      ],
      "js": [
        "lib/jszip.min.js",
        "content/ui.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lib/*",
        "content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
