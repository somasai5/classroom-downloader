{
  "manifest_version": 3,
  "name": "Classroom Suite - Quick Downloader & Organizer",
  "version": "2.1.0",
  "description": "1-click batch download & smart ZIP organizer for Google Classroom. 100% client-side, zero servers, zero API keys.",
  "author": "Classroom Suite Open Source",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Classroom Suite Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://classroom.google.com/*",
    "*://drive.google.com/*",
    "*://docs.google.com/*",
    "*://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://classroom.google.com/*",
        "*://*/*test_classroom.html*",
        "file:///*"
      ],
      "js": [
        "content/route_interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://classroom.google.com/*",
        "*://*/*test_classroom.html*",
        "file:///*"
      ],
      "js": [
        "lib/jszip.min.js",
        "content/ui.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lib/*",
        "content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}